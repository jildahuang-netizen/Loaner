let u=fixed(op,shaTail_(ip,utf8_(salt).concat([0,0,0,1]),64));const result=u.slice();for(let n=1;n<iterations;n++){u=fixed(op,fixed(ip,u));for(let i=0;i<8;i++)result[i]^=u[i];}return result.map(w=>(w>>>0).toString(16).padStart(8,'0')).join('');}
function passwordSchema_(){const b=book_();if(!b.getSheetByName('Passwords'))b.insertSheet('Passwords').appendRow(['id','verifier','updatedAt']);}
function credential_(email){passwordSchema_();const r=rows_('Passwords').find(r=>r.id===email);return r?parse_(r.verifier):null;}
function checkPasswordInput_(password){if(typeof password!=='string'||password.length<12||password.length>128)throw new Error('Password must be 12–128 characters.');}
function savePassword_(email,password){checkPasswordInput_(password);passwordSchema_();const salt=Utilities.getUuid()+Utilities.getUuid();const verifier={algorithm:'pbkdf2-sha256',iterations:PASSWORD_ITERATIONS_,salt,hash:pbkdf2_(password,salt,PASSWORD_ITERATIONS_),version:Utilities.getUuid()};const value=JSON.stringify(verifier);if(rows_('Passwords').some(r=>r.id===email))update_('Passwords',email,{verifier:value,updatedAt:stamp_()});else add_('Passwords',[email,value,stamp_()]);}
function equalHash_(a,b){if(typeof a!=='string'||typeof b!=='string'||a.length!==b.length)return false;let diff=0;for(let i=0;i<a.length;i++)diff|=a.charCodeAt(i)^b.charCodeAt(i);return diff===0;}
