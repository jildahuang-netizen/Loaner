// ==================== Code.gs ====================
/** Set your administrator Gmail address, then run setup once. */
const ADMIN_EMAIL = 'replace-with-your-email@gmail.com';
const PURPOSES = ['Business capital','Equipment purchase','Education / tuition','Medical expenses','Home improvement','Vehicle purchase / repair','Debt consolidation','Emergency expenses','Personal / family expenses','Agriculture / farming','Other'];
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Loaner - Your Lending App').addMetaTag('viewport','width=device-width, initial-scale=1');}
function setup(){
 const email=Session.getActiveUser().getEmail().toLowerCase();
 if(email!==ADMIN_EMAIL.toLowerCase()||ADMIN_EMAIL.indexOf('replace-with')===0)throw new Error('Set ADMIN_EMAIL to your own Gmail address first.');
 const props=PropertiesService.getScriptProperties();if(props.getProperty('SHEET_ID'))throw new Error('Already configured. Existing records were preserved.');
 const book=SpreadsheetApp.create('Loaner - Your Lending App');
 const users=book.getSheets()[0];users.setName('Users');users.appendRow(['id','name','email','role']);users.appendRow([Utilities.getUuid(),'Administrator',email,'admin']);
 book.insertSheet('Loans').appendRow(['id','userId','client','purpose','principal','rate','term','start']);
 book.insertSheet('Payments').appendRow(['id','loanId','amount','interest','principal','date','due','recordedBy']);
 props.setProperty('SHEET_ID',book.getId());console.log('Loaner data spreadsheet: '+book.getUrl());
}
function book_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw new Error('Run setup first.');return SpreadsheetApp.openById(id);}
function rows_(name){const values=book_().getSheetByName(name).getDataRange().getValues();const keys=values.shift();return values.filter(r=>r[0]).map(r=>Object.fromEntries(keys.map((k,i)=>[k,r[i] instanceof Date?Utilities.formatDate(r[i],Session.getScriptTimeZone(),'yyyy-MM-dd'):k==='term'?String(r[i]):r[i]])));}
function hash_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('');}
function me_(token){if(typeof token!=='string'||token.length>100)throw new Error('Please sign in.');const raw=CacheService.getScriptCache().get('session:'+hash_(token));if(!raw)throw new Error('Session expired. Sign in again.');const auth=JSON.parse(raw);if(auth.expires<Date.now())throw new Error('Session expired.');const u=rows_('Users').find(u=>u.id===auth.id);if(!u)throw new Error('Access denied.');const credential=credential_(u.email);if(!credential||credential.mustChange||auth.version!==credential.version)throw new Error('Session expired. Sign in with your password.');return u;}
function admin_(token){const u=me_(token);if(u.role!=='admin')throw new Error('Only admins can perform this action.');return u;}
function requestCode(email){return locked_(()=>{
 email=String(email||'').trim().toLowerCase();if(email.length>254||!/^\S+@\S+\.\S+$/.test(email))throw new Error('Enter a valid email.');
 const cache=CacheService.getScriptCache(),key=hash_(email),old=cache.get('cooldown:'+key);if(old)throw new Error('Wait one minute before requesting another code.');
 const count=Number(cache.get('mail-global')||0);if(count>=20)throw new Error('Sign-in is busy. Try again in a minute.');cache.put('mail-global',String(count+1),60);cache.put('cooldown:'+key,'1',60);
 const u=rows_('Users').find(u=>u.email===email);if(!u)return 'If this email is authorized, a code has been sent.';
 const code=Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase();const salt=Utilities.getUuid();
 cache.put('otp:'+key,JSON.stringify({hash:hash_(salt+code),salt,tries:0,expires:Date.now()+600000}),600);
 MailApp.sendEmail({to:email,subject:'Your Loaner password recovery code',body:'Your Loaner password recovery code is: '+code+'\n\nExpires in 10 minutes. Do not share this code. If you did not request it, ignore this email.'});
 return 'If this email is authorized, a code has been sent.';
});}
function verifyCode(){throw new Error('Sign in with your registered email and password. Email codes are used only for registration and password recovery.');}
function signOut(token){if(typeof token==='string')CacheService.getScriptCache().remove('session:'+hash_(token));}
function locked_(fn){const lock=LockService.getScriptLock();lock.waitLock(30000);try{return fn();}finally{lock.releaseLock();}}
function add_(sheet,values){const safe=values.map(v=>typeof v==='string'&&/^[=+@-]/.test(v)?"'"+v:v);book_().getSheetByName(sheet).appendRow(safe);SpreadsheetApp.flush();}
function getState(token){const u=me_(token);const users=rows_('Users');const loans=rows_('Loans').filter(l=>u.role==='admin'||l.userId===u.id);const payments=rows_('Payments');return {features:featureState_(u),user:u,accounts:u.role==='admin'?users:[u],loans:loans.map(l=>({...l,start:String(l.start),plan:(rows_('Requests').find(r=>r.loanId===l.id&&r.status==='approved')||{}).snapshot?JSON.parse(rows_('Requests').find(r=>r.loanId===l.id&&r.status==='approved').snapshot):null,payments:payments.filter(p=>p.loanId===l.id)}))};}
function createUser(data,token){return locked_(()=>{admin_(token);const name=String(data.name||'').trim(),email=String(data.email||'').trim().toLowerCase(),role=data.role;if(!name||name.length>100||!/^\S+@\S+\.\S+$/.test(email)||!['admin','client'].includes(role))throw new Error('Use a name, valid email, and valid role.');if(rows_('Users').some(u=>u.email===email))throw new Error('Email already exists.');add_('Users',[Utilities.getUuid(),name,email,role]);return getState(token);});}
function validDate_(date){return /^\d{4}-\d{2}-\d{2}$/.test(date)&&!isNaN(Date.parse(date+'T12:00:00Z'))&&new Date(date+'T12:00:00Z').toISOString().slice(0,10)===date;}
function createLoan(data,token){admin_(token);throw new Error('Use Loan requests. Contracts are generated only after approval.');}
function due_(l,period){const parts=String(l.start).split('-').map(Number);let date;if(l.term==='monthly'){date=new Date(Date.UTC(parts[0],parts[1]-1+period,1));const last=new Date(Date.UTC(date.getUTCFullYear(),date.getUTCMonth()+1,0)).getUTCDate();date.setUTCDate(Math.min(parts[2],last));}else{date=new Date(Date.UTC(parts[0],parts[1]-1,parts[2]));date.setUTCDate(date.getUTCDate()+Number(l.term)*period);}return date.toISOString().slice(0,10);}
function recordPayment(data,token){admin_(token);ensureFeatures_();if(rows_('Requests').some(r=>r.loanId===data.loanId&&r.status==='approved'))return recordPlannedPayment_(data,token);return locked_(()=>{const u=admin_(token);const l=rows_('Loans').find(l=>l.id===data.loanId);if(!l)throw new Error('Loan not found.');const history=rows_('Payments').filter(p=>p.loanId===l.id);const remaining=Number(l.principal)-history.reduce((s,p)=>s+Number(p.principal),0);const interest=Math.round(remaining*Number(l.rate)/100*(l.term==='15'?0.5:1));const amount=Math.round(Number(data.amount)*100);const date=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd');if(remaining<=0||!Number.isSafeInteger(amount)||amount<=0||amount<interest||amount>remaining+interest)throw new Error('Payment must cover the period interest and cannot exceed full settlement.');const next=remaining===amount-interest?'Paid in full':due_(l,history.length+2);add_('Payments',[Utilities.getUuid(),l.id,amount,interest,amount-interest,date,next,u.email]);return getState(token);});}


// ==================== Features.gs ====================
/** Annual document review, loan requests, and contracts. All files remain private. */
const FEATURE_HEADERS_={
 Requirements:['id','userId','status','payload','createdAt','reviewedAt','validUntil','reviewedBy','note'],
 Requests:['id','userId','status','payload','createdAt','reviewedAt','reviewedBy','note','loanId','contractId','snapshot'],
 Settings:['key','value'],
 Passwords:['id','verifier','updatedAt'],
 Registrations:['id','name','email','phone','status','createdAt','verifiedAt','reviewedAt','reviewedBy','note','userId','emailStatus']
};
const REQUIRED_SLOTS_=['id1','id2','coe','payslip1','payslip2','payslip3'];
function ensureFeatures_(){const b=book_();const pay=b.getSheetByName('Payments');const headers=pay.getRange(1,1,1,pay.getLastColumn()).getValues()[0];if(!headers.includes('kind'))pay.getRange(1,headers.length+1).setValue('kind');Object.keys(FEATURE_HEADERS_).forEach(name=>{if(!b.getSheetByName(name))b.insertSheet(name).appendRow(FEATURE_HEADERS_[name]);});}
function today_(){return Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd');}
function stamp_(){return new Date().toISOString();}
function parse_(raw){try{return JSON.parse(raw||'{}');}catch(e){throw new Error('Invalid stored data.');}}
function update_(sheet,id,patch){const sh=book_().getSheetByName(sheet),data=sh.getDataRange().getValues(),headers=data[0],i=data.findIndex((r,n)=>n>0&&r[0]===id);if(i<1)throw new Error('Record not found.');Object.entries(patch).forEach(([key,value])=>{const c=headers.indexOf(key);if(c<0)throw new Error('Unknown field.');data[i][c]=typeof value==='string'&&/^[=+@-]/.test(value)?"'"+value:value;});sh.getRange(i+1,1,1,headers.length).setValues([data[i]]);SpreadsheetApp.flush();}
function removeRow_(sheet,id){const sh=book_().getSheetByName(sheet),data=sh.getDataRange().getValues(),i=data.findIndex((r,n)=>n>0&&r[0]===id);if(i>0)sh.deleteRow(i+1);}
function folder_(){const props=PropertiesService.getScriptProperties();let id=props.getProperty('DOCUMENT_FOLDER');if(!id){const f=DriveApp.createFolder('Loaner private requirements and contracts');f.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);id=f.getId();props.setProperty('DOCUMENT_FOLDER',id);}const folder=DriveApp.getFolderById(id);if(folder.getSharingAccess()!==DriveApp.Access.PRIVATE||folder.getEditors().length||folder.getViewers().length)throw new Error('Keep the Loaner documents folder private to the deploying owner.');return folder;}
function settings_(){ensureFeatures_();return Object.fromEntries(rows_('Settings').map(r=>[r.key,parse_(r.value)]));}
function saveLenderSettings(data,token){return locked_(()=>{admin_(token);ensureFeatures_();const out={};for(const k of ['legalName','address','representative','position','phone','email','paymentInstructions','signingPlace']){out[k]=String(data[k]||'').trim();if(!out[k]||out[k].length>500)throw new Error('Complete all lender and payment details.');}const grace=Number(data.graceDays);if(!Number.isInteger(grace)||grace<1||grace>90)throw new Error('Notice period must be 1–90 days.');out.graceDays=grace;const existing=rows_('Settings').find(r=>r.key==='lender');if(existing)update_('Settings','lender',{value:JSON.stringify(out)});else add_('Settings',['lender',JSON.stringify(out)]);return getState(token);});}
function featureState_(u){ensureFeatures_();const requirements=rows_('Requirements').filter(r=>u.role==='admin'||r.userId===u.id).map(r=>({...r,payload:parse_(r.payload)}));const requests=rows_('Requests').filter(r=>u.role==='admin'||r.userId===u.id).map(r=>({...r,payload:parse_(r.payload),snapshot:r.snapshot?parse_(r.snapshot):null}));return {registrations:u.role==='admin'?rows_('Registrations'):[],membership:u.role==='admin'?'admin':validPack_(u.id)?'active':'requirements_needed',requirements,requests,settings:u.role==='admin'?settings_():{},today:today_()};}
function anniversary_(date){const [y,m,d]=date.split('-').map(Number);const last=new Date(Date.UTC(y+1,m,0)).getUTCDate();return [y+1,String(m).padStart(2,'0'),String(Math.min(d,last)).padStart(2,'0')].join('-');}
function validPack_(userId){const packs=rows_('Requirements').filter(r=>r.userId===userId&&r.status==='approved'&&String(r.validUntil)>today_()).sort((a,b)=>String(b.reviewedAt).localeCompare(String(a.reviewedAt)));return packs.find(r=>{const p=parse_(r.payload);return [p.id1,p.id2].every(id=>id&&(!id.expiry||id.expiry>=today_()));})||null;}
function ownPack_(id,u){const pack=rows_('Requirements').find(r=>r.id===id);if(!pack||(u.role!=='admin'&&pack.userId!==u.id))throw new Error('Requirements not found.');return pack;}
function saveRequirements(data,token){return locked_(()=>{const u=me_(token);ensureFeatures_();if(u.role!=='client')throw new Error('Clients submit their own requirements.');const p={};for(const key of ['fullName','address','phone','employer']){p[key]=String(data[key]||'').trim();if(!p[key]||p[key].length>250)throw new Error('Complete your personal and employment details.');}if(!validDate_(data.birthDate)||data.birthDate>today_())throw new Error('Enter your date of birth.');const adult=new Date(data.birthDate+'T00:00:00Z');adult.setUTCFullYear(adult.getUTCFullYear()+18);if(adult.toISOString().slice(0,10)>today_())throw new Error('Borrower must be at least 18.');p.birthDate=data.birthDate;p.email=u.email;
 for(const slot of ['id1','id2']){const v=data[slot]||{};if(!v.type||!v.number||String(v.type).length>80||String(v.number).length>100)throw new Error('Enter details for both valid IDs.');if(v.expiry&&(!validDate_(v.expiry)||v.expiry<today_()))throw new Error('ID is expired or expiry date is invalid.');p[slot]={type:String(v.type),number:String(v.number),expiry:v.expiry||''};}
 if(p.id1.type.toLowerCase()===p.id2.type.toLowerCase()&&p.id1.number.toLowerCase()===p.id2.number.toLowerCase())throw new Error('Provide two different IDs.');
 p.payslipMonths=(data.payslipMonths||[]).map(String);if(p.payslipMonths.length!==3||new Set(p.payslipMonths).size!==3||p.payslipMonths.some(m=>!/^\d{4}-(0[1-9]|1[0-2])$/.test(m)||m>today_().slice(0,7)))throw new Error('Enter three distinct, non-future payslip months.');
 const existing=rows_('Requirements').find(r=>r.userId===u.id&&r.status==='draft');p.files=existing?parse_(existing.payload).files||{}:{};
 if(existing)update_('Requirements',existing.id,{payload:JSON.stringify(p)});else add_('Requirements',[Utilities.getUuid(),u.id,'draft',JSON.stringify(p),stamp_(),'','','','']);return getState(token);});}
function uploadRequirement(data,token){return locked_(()=>{const u=me_(token);ensureFeatures_();const pack=ownPack_(data.packId,u);if(pack.userId!==u.id||pack.status!=='draft')throw new Error('Only your draft requirements can be changed.');if(!REQUIRED_SLOTS_.concat(['proofAddress','recommendation']).includes(data.slot))throw new Error('Invalid document type.');const p=parse_(pack.payload),blob=uploadBlob_(data);const f=folder_().createFile(blob);f.setName(pack.id+'-'+data.slot+'-'+blob.getName());const old=p.files[data.slot];p.files[data.slot]={id:f.getId(),name:blob.getName(),mime:blob.getContentType(),uploadedAt:stamp_()};try{update_('Requirements',pack.id,{payload:JSON.stringify(p)});}catch(e){f.setTrashed(true);throw e;}if(old)try{DriveApp.getFileById(old.id).setTrashed(true);}catch(e){}return getState(token);});}
function uploadBlob_(data){const mime=String(data.mime||'');if(!['application/pdf','image/jpeg','image/png'].includes(mime))throw new Error('Upload PDF, JPG, or PNG only.');if(typeof data.base64!=='string'||data.base64.length>7000000)throw new Error('File must be 5 MB or smaller.');const bytes=Utilities.base64Decode(data.base64);if(!bytes.length||bytes.length>5*1024*1024)throw new Error('File must be 5 MB or smaller.');const a=bytes.slice(0,8).map(v=>v&255);if((mime==='application/pdf'&&a.slice(0,5).join(',')!=='37,80,68,70,45')||(mime==='image/jpeg'&&a.slice(0,3).join(',')!=='255,216,255')||(mime==='image/png'&&a.join(',')!=='137,80,78,71,13,10,26,10'))throw new Error('File contents do not match the selected file type.');const name=String(data.name||'document').replace(/[^a-zA-Z0-9._ -]/g,'_').slice(0,100);return Utilities.newBlob(bytes,mime,name);}
function submitRequirements(packId,token){return locked_(()=>{const u=me_(token);ensureFeatures_();const r=ownPack_(packId,u);if(r.userId!==u.id||r.status!=='draft')throw new Error('Only your draft may be submitted.');const p=parse_(r.payload);if(REQUIRED_SLOTS_.some(k=>!p.files[k]))throw new Error('Upload both IDs, COE, and three payslips first.');if([p.id1,p.id2].some(v=>v.expiry&&v.expiry<today_()))throw new Error('Replace expired IDs.');update_('Requirements',r.id,{status:'pending'});return getState(token);});}
function reviewRequirements(data,token){return locked_(()=>{const u=admin_(token);ensureFeatures_();const r=ownPack_(data.id,u);if(r.status!=='pending'||!['approved','rejected'].includes(data.status))throw new Error('Select a pending requirements pack.');const p=parse_(r.payload);if(data.status==='approved'&&(REQUIRED_SLOTS_.some(k=>!p.files[k])||[p.id1,p.id2].some(v=>v.expiry&&v.expiry<today_())))throw new Error('Requirements are incomplete or an ID expired.');const note=String(data.note||'').trim().slice(0,1000);if(data.status==='rejected'&&!note)throw new Error('Explain what the client needs to correct.');update_('Requirements',r.id,{status:data.status,reviewedAt:stamp_(),validUntil:data.status==='approved'?anniversary_(today_()):'',reviewedBy:u.email,note});return getState(token);});}
function submitLoanRequest(data,token){return locked_(()=>{const u=me_(token);ensureFeatures_();const userId=u.role==='admin'?String(data.userId||''):u.id;const client=rows_('Users').find(c=>c.id===userId&&c.role==='client');if(!client||!validPack_(userId))throw new Error('Current admin-approved yearly requirements are needed before a loan request.');const amount=Number(data.principal),months=Number(data.months);if(!Number.isFinite(amount)||amount<1||amount>100000000||!Number.isInteger(months)||!eligibleMonths_(Math.round(amount*100),months)||!['15','monthly'].includes(data.term)||!PURPOSES.includes(data.purpose))throw new Error('Check amount, purpose, payment terms, and duration: below ₱10,000 = 1 month; ₱10,000 and above = 3, 6, 9, or 12 months.');const p={principal:Math.round(amount*100),purpose:data.purpose,term:data.term,months,processingFee:Math.round(amount*100*0.023),client:client.name};add_('Requests',[Utilities.getUuid(),userId,'pending',JSON.stringify(p),stamp_(),'','','','','','']);return getState(token);});}
function approveLoanRequest(data,token){return locked_(()=>{const admin=admin_(token);ensureFeatures_();let r=rows_('Requests').find(x=>x.id===data.id);if(!r)throw new Error('Request not found.');if(r.status==='approved')return getState(token);if(r.status!=='pending')throw new Error('Request has already been reviewed.');const pack=validPack_(r.userId);if(!pack)throw new Error('Client must renew yearly requirements before approval.');const settings=settings_().lender;if(!settings||['legalName','address','representative','position','phone','email','paymentInstructions','signingPlace','graceDays'].some(k=>!settings[k]))throw new Error('Complete lender contract settings first.');const rate=Number(data.rate),start=String(data.start||'');if(!Number.isFinite(rate)||rate<0||rate>100||!validDate_(start)||start<today_())throw new Error('Enter a monthly rate and a start date of today or later.');const p={...parse_(r.payload),rate,start};const client=parse_(pack.payload);if(!eligibleMonths_(p.principal,p.months))throw new Error('Invalid duration for this amount.');const approvedAt=stamp_();const loanId=Utilities.getUuid();const snapshot={requestId:r.id,loanId,approvedAt,approvedBy:admin.email,requirementsId:pack.id,client,lender:settings,loan:p,schedule:repaymentSchedule_(p)};delete snapshot.client.files;
 const contract=generateContract_(snapshot);try{add_('Loans',[loanId,r.userId,client.fullName,p.purpose,p.principal,rate,p.term,start]);update_('Requests',r.id,{status:'approved',reviewedAt:approvedAt,reviewedBy:admin.email,loanId,contractId:contract.getId(),snapshot:JSON.stringify(snapshot),note:''});}catch(e){removeRow_('Loans',loanId);contract.setTrashed(true);throw e;}return getState(token);});}
function rejectLoanRequest(data,token){return locked_(()=>{const u=admin_(token);ensureFeatures_();const r=rows_('Requests').find(r=>r.id===data.id);const note=String(data.note||'').trim().slice(0,1000);if(!r||r.status!=='pending'||!note)throw new Error('Select a pending request and provide a reason.');update_('Requests',r.id,{status:'rejected',reviewedAt:stamp_(),reviewedBy:u.email,note});return getState(token);});}
function downloadPrivateFile(data,token){const u=me_(token);ensureFeatures_();let id='';if(data.kind==='requirement'){const r=ownPack_(data.recordId,u);const f=parse_(r.payload).files[data.slot];if(!f)throw new Error('Document not found.');id=f.id;}else if(data.kind==='contract'){const r=rows_('Requests').find(r=>r.id===data.recordId);if(!r||r.status!=='approved'||(u.role!=='admin'&&r.userId!==u.id))throw new Error('Contract not found.');id=r.contractId;}else throw new Error('Invalid document request.');const f=DriveApp.getFileById(id);if(f.isTrashed())throw new Error('File unavailable.');const blob=f.getBlob();return {name:f.getName(),mime:blob.getContentType(),base64:Utilities.base64Encode(blob.getBytes())};}
function eligibleMonths_(principal,months){return principal<1000000?months===1:[3,6,9,12].includes(months);}
// Scheduled principal plus interest; 2 installments per month for bi-monthly loans.
function repaymentSchedule_(p){const n=p.months*(p.term==='15'?2:1),r=p.rate/100*(p.term==='15'?0.5:1);let balance=p.principal;return Array.from({length:n},(_,i)=>{const principal=Math.round(p.principal*(i+1)/n)-Math.round(p.principal*i/n);const interest=p.principal<1000000?Math.round(p.principal*p.rate/100*(i+1)/n)-Math.round(p.principal*p.rate/100*i/n):Math.round(balance*r);balance-=principal;return {period:i+1,date:due_(p,i+1),principal,interest,amount:principal+interest,balance};});}
function planState_(snapshot,history){const principal=Math.max(0,snapshot.loan.principal-history.reduce((v,p)=>v+Number(p.principal),0));const principalPaid=snapshot.loan.principal-principal;const extensions=history.filter(p=>p.kind==='interest_only').length;let allocated=principalPaid;const rows=snapshot.schedule.map((r,i)=>{const paid=Math.min(allocated,r.principal);allocated-=paid;return {...r,date:due_(snapshot.loan,i+1+extensions),unpaidPrincipal:r.principal-paid,unpaidInterest:paid>=r.principal?0:r.interest};});const next=rows.find(r=>r.unpaidPrincipal>0);const interest=next?next.unpaidInterest:0;const nextAmount=next?next.unpaidPrincipal+interest:0;const settlement=principal+(snapshot.loan.principal<1000000?rows.reduce((v,r)=>v+r.unpaidInterest,0):interest);return {principal,interest,nextAmount,settlement,due:next?next.date:'',rows,extensions};}
function recordPlannedPayment_(data,token){return locked_(()=>{const u=admin_(token);ensureFeatures_();const r=rows_('Requests').find(r=>r.loanId===data.loanId&&r.status==='approved');if(!r)throw new Error('Approved loan not found.');const s=parse_(r.snapshot);const history=rows_('Payments').filter(p=>p.loanId===r.loanId);const state=planState_(s,history);const kind=String(data.kind||'installment');if(!['installment','interest_only','settlement'].includes(kind)||!state.principal)throw new Error('Invalid payment or loan already paid.');const amount=Math.round(Number(data.amount)*100);const expected=kind==='interest_only'?state.interest:kind==='settlement'?state.settlement:state.nextAmount;if(expected<=0||!Number.isSafeInteger(amount)||amount!==expected)throw new Error('Payment amount must match '+peso_(expected)+' for the selected payment option.');if(today_()<s.loan.start)throw new Error('Payments cannot be recorded before the release date.');const interest=kind==='settlement'?amount-state.principal:state.interest;const principal=kind==='interest_only'?0:amount-interest;const record={amount,interest,principal,kind};const after=planState_(s,history.concat([record]));const row=[Utilities.getUuid(),r.loanId,amount,interest,principal,today_(),after.principal?after.due:'Paid in full',u.email,kind];add_('Payments',row);return getState(token);});}


// ==================== Registration.gs ====================
/** Public registration verifies mailbox ownership; only admin approval creates access. */
function registrationSchema_(){ensureFeatures_();const b=book_();if(!b.getSheetByName('Registrations'))b.insertSheet('Registrations').appendRow(['id','name','email','phone','status','createdAt','verifiedAt','reviewedAt','reviewedBy','note','userId','emailStatus']);}
function validEmail_(value){const email=String(value||'').trim().toLowerCase();if(email.length>254||! /^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$/.test(email))throw new Error('Enter a valid email address.');return email;}
function registrationCode(email){return locked_(()=>{registrationSchema_();email=validEmail_(email);const cache=CacheService.getScriptCache(),key=hash_(email);if(cache.get('cooldown:'+key))throw new Error('Wait a minute before requesting another code.');const count=Number(cache.get('mail-global')||0);if(count>=20)throw new Error('Sign-up is busy. Try again shortly.');cache.put('cooldown:'+key,'1',60);cache.put('mail-global',String(count+1),60);const code=Utilities.getUuid().replace(/-/g,'').slice(0,8).toUpperCase(),salt=Utilities.getUuid();cache.put('register:'+key,JSON.stringify({hash:hash_(salt+code),salt,tries:0,expires:Date.now()+600000}),600);MailApp.sendEmail({to:email,subject:'Verify your email for Loaner registration',body:'Your Loaner registration code is '+code+'.\n\nIt expires in 10 minutes. Enter it only on your Loaner registration page. Registration requires System Admin Approval; this code does not grant loan or account approval.'});return 'A verification code has been sent. Check your inbox and spam folder.';});}
function submitRegistration(data){return locked_(()=>{registrationSchema_();const email=validEmail_(data.email),name=String(data.name||'').trim(),phone=String(data.phone||'').trim();if(!name||name.length>100||phone.length>40)throw new Error('Enter your full name and valid contact details.');checkPasswordInput_(data.password);const cache=CacheService.getScriptCache(),key='register:'+hash_(email),raw=cache.get(key);if(!raw)throw new Error('Request a verification code first.');const otp=JSON.parse(raw);if(otp.expires<Date.now()||otp.tries>=5){cache.remove(key);throw new Error('Code expired. Request another.');}if(hash_(otp.salt+String(data.code||'').trim().toUpperCase())!==otp.hash){otp.tries++;cache.put(key,JSON.stringify(otp),Math.max(1,Math.floor((otp.expires-Date.now())/1000)));throw new Error('Incorrect verification code.');}cache.remove(key);if(rows_('Users').some(u=>u.email===email))throw new Error('This email already has an account. Return to sign in.');savePassword_(email,data.password);if(!rows_('Registrations').some(r=>r.email===email&&r.status==='pending'))add_('Registrations',[Utilities.getUuid(),name,email,phone,'pending',stamp_(),stamp_(),'','','','','not_sent']);return 'Success! Once approved you will receive an Email Confirmation.';});}
function reviewRegistration(data,token){return locked_(()=>{const admin=admin_(token);registrationSchema_();const r=rows_('Registrations').find(r=>r.id===data.id);if(!r)throw new Error('Registration not found.');if(data.status==='rejected'){if(r.status!=='pending')throw new Error('Registration already reviewed.');const note=String(data.note||'').trim().slice(0,1000);if(!note)throw new Error('Enter a rejection reason.');update_('Registrations',r.id,{status:'rejected',note,reviewedAt:stamp_(),reviewedBy:admin.email});return getState(token);}if(data.status!=='approved')throw new Error('Invalid approval decision.');if(!['pending','approved'].includes(r.status))throw new Error('Registration already reviewed.');if(r.status==='pending'){let existing=rows_('Users').find(u=>u.email===r.email);if(existing&&existing.role!=='client')throw new Error('Email belongs to an administrator.');const userId=existing?existing.id:Utilities.getUuid();if(!existing)add_('Users',[userId,r.name,r.email,'client']);try{update_('Registrations',r.id,{status:'approved',userId,reviewedAt:stamp_(),reviewedBy:admin.email,note:''});}catch(e){if(!existing)removeRow_('Users',userId);throw e;}}
 const refreshed=rows_('Registrations').find(x=>x.id===r.id);if(refreshed.emailStatus!=='sent'){const url=ScriptApp.getService().getUrl();if(!url){update_('Registrations',r.id,{emailStatus:'failed: deploy web app first'});return getState(token);}try{MailApp.sendEmail({to:r.email,subject:'Loaner account approved — Sign in to complete requirements',body:'Hello '+r.name+',\n\nYour Loaner account has been approved by the System Admin.\n\nSign in here: '+url+'\n\nUse your registered email and password. If your account was created before password sign-in was added, use Set or reset password on the login page first. After signing in, submit two valid IDs, COE, and three monthly payslips under Requirements. The admin will review your requirements before activating your loan eligibility. Account approval is not loan approval.\n\nLoaner - Your Lending App\nPowered by: Jilyellow'});update_('Registrations',r.id,{emailStatus:'sent'});}catch(e){update_('Registrations',r.id,{emailStatus:'failed: retry confirmation'});}}
 return getState(token);});}


