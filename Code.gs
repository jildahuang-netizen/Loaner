function generateContract_(snapshot){const source=Utilities.newBlob(Utilities.base64Decode(CONTRACT_TEMPLATE_BASE64_),'application/zip','template.zip');const files=Utilities.unzip(source);let found=false;files.forEach(blob=>{if(blob.getName()==='word/document.xml'){blob.setDataFromString(contractXml_(snapshot,blob.getDataAsString()));found=true;}});if(!found)throw new Error('Template contents unavailable.');const blob=Utilities.zip(files,'Loaner-Contract-'+snapshot.loanId+'.docx').setContentType('application/vnd.openxmlformats-officedocument.wordprocessingml.document');return folder_().createFile(blob);}


